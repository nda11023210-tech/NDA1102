# Chuỗi kết nối MySQL (Hostinger hPanel → Databases → MySQL Databases)
# Định dạng: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://u123456789_kcntt:mat-khau@localhost:3306/u123456789_kcntt"

# Chuỗi bí mật ký phiên đăng nhập – tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"

# Thư mục lưu tệp tải lên. Trên Hostinger nên đặt NGOÀI thư mục mã nguồn để không bị xóa khi deploy lại
UPLOAD_DIR="./storage/uploads"

# Claude API (chatbot + nhận xét hiệu suất). Bỏ trống thì hệ thống dùng chế độ tra cứu không AI
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Mật khẩu mặc định cho tài khoản mẫu khi chạy seed
SEED_PASSWORD="Kcntt@2026"
