{
  "name": "cong-khoa-cntt-bnic",
  "version": "1.0.0",
  "private": true,
  "description": "Cổng quản trị nội bộ Khoa Công nghệ Thông tin – Trường Cao đẳng Công nghiệp Bắc Ninh",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:prod": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "local:sqlite": "node scripts/local-sqlite.mjs",
    "test:solver": "tsx scripts/test-solver.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "jose": "6.2.13",
    "lucide-react": "1.62.0",
    "next": "15.5.28",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.21",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
